# Copia este archivo a backend/.env y completa los valores reales.
# backend/.env NO se sube a git (esta en .gitignore).
# Cargar en terminal:  set -a; source .env; set +a
# En IntelliJ: Run > Edit Configurations > Environment variables.

# --- Base de datos (Neon) ---
DB_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- JWT: secreto largo y aleatorio (ej: openssl rand -base64 48) ---
JWT_SECRET=

# --- Correo SMTP (opcional si no envias correos) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Opcionales ---
# CORS_ORIGINS=http://localhost:5500
# RATE_LIMIT_MAX=10
# RATE_LIMIT_VENTANA_SEG=60
# FORWARD_HEADERS_STRATEGY=framework   # solo detras de un proxy de confianza
